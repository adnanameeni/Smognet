# SmogNet Environment Variables
# Copy this file to .env and fill in your actual values

# ── Email Alerts (Gmail SMTP) ─────────────────────────────
# 1. Go to myaccount.google.com → Security → App Passwords
# 2. Generate an App Password for "Mail"
# 3. Paste it below (NOT your regular Gmail password)
SMTP_EMAIL=your_gmail@gmail.com
SMTP_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx

# Email to receive automatic spike alerts
ALERT_EMAIL=recipient@example.com

# ── Groq API (Optional — AI-enhanced alerts) ─────────────
# Get free API key at: https://console.groq.com
GROQ_API_KEY=gsk_R6bkGrfutVwYt1hiNgihWGdyb3FY7A6NRCexsjIDsDnHKfhO1G
